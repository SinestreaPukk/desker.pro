{
  "rewrites": [
    {
      "source": "/api/ics",
      "destination": "/api/state?feed=1"
    },
    {
      "source": "/api/(signup|login|logout|me|forgot-password|reset-password|account)",
      "destination": "/api/auth/x"
    },
    {
      "source": "/api/auth/:a/:b*",
      "destination": "/api/auth/x"
    },
    {
      "source": "/(today|tasks|goals|projects|deadlines|dsb|calendar|rhythm|do-now|reset-password|login|signup|forgot-password|privacy|terms)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://www.google.com/recaptcha/ https://get.geojs.io https://api.open-meteo.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/"
        }
      ]
    }
  ]
}
