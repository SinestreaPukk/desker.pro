{
  "rewrites": [
    {
      "source": "/api/ics",
      "destination": "/api/state?feed=1"
    },
    {
      "source": "/api/auth/:a/:b*",
      "destination": "/api/auth/x"
    },
    {
      "source": "/(today|tasks|goals|projects|deadlines|dsb|calendar|do-now|reset-password|login|signup|forgot-password)",
      "destination": "/index.html"
    }
  ]
}
