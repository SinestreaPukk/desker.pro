{
  "rewrites": [
    {
      "source": "/api/village/:first/:rest*",
      "destination": "/api/village/:first?rest=:rest*"
    },
    {
      "source": "/((?!assets/|maps/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/village/cron",
      "schedule": "0 5 * * *"
    }
  ]
}
