ANTHROPIC_API_KEY=
BETTER_AUTH_SECRET=      # 32+ random chars: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000   # the site's public origin
RESEND_API_KEY=          # optional locally (mails are logged); required in production
EMAIL_FROM=Desker <hello@your-domain>
GOOGLE_CLIENT_ID=        # optional: Google sign-in
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=        # optional: GitHub sign-in
GITHUB_CLIENT_SECRET=

# The owner dashboard at /dsb is for these signed-in accounts only (comma separated, verified email). Everyone else gets a 404. There is no password.
ADMIN_EMAILS=

# The kodama's notifications (web push). All five must be set or the toggle in Settings stays hidden and the sender refuses to run.
# Generate the key pair once with:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=   # the public key (also exposed to the browser)
VAPID_PUBLIC_KEY=        # the same public key, for the server
VAPID_PRIVATE_KEY=       # the private key: server only, never commit it
VAPID_SUBJECT=           # mailto:you@example.com
CRON_SECRET=             # any long random string; the hourly caller sends it as "Authorization: Bearer <secret>"

# Product analytics (Phase 8). Off unless both are 'on'. Needs db/migrations/002_events.sql applied. See README.
ANALYTICS=               # on = the server accepts events
VITE_ANALYTICS=          # on = the app sends them (build-time, so set it before building)
