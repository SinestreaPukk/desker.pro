{
  "name": "eisenhower",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test test/*.test.mjs",
    "pixel:draw": "python3 art/authoring/gen_sprites.py && python3 art/authoring/gen_house.py",
    "pixel:build": "python3 pixel-kit/tools/sprite_build.py art/sprites --palette pixel-kit/art/palette/yuki16.json --out public/pixel && python3 art/scene_build.py",
    "pixel:lint": "sh scripts/pixel-lint.sh",
    "test:pixel": "playwright test"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "ical.js": "^2.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
